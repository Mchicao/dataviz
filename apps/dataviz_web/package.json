{
  "name": "dataviz-web",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@12.2.0",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=26.7.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && vite build --config vite.studio.config.ts",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "prepare": "effect-tsgo patch --typescript --oxlint"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "overrides": {
    "@testing-library/react": {
      "react": "$react",
      "react-dom": "$react-dom"
    }
  },
  "devDependencies": {
    "@effect/tsgo": "0.48.1",
    "@gdp-ts/core": "0.1.0",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "effect": "4.0.1",
    "jsdom": "30.1.2",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "typescript": "7.0.2",
    "ultracite": "7.12.4",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}

{
  "name": "dataviz-web",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@12.2.0",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=26.7.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && vite build --config vite.studio.config.ts",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "prepare": "effect-tsgo patch --typescript --oxlint",
    "deploy:demo": "npm run build && wrangler deploy",
    "dev:demo": "wrangler dev --ip 127.0.0.1 --persist-to ../../.cache/wrangler"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "overrides": {
    "@testing-library/react": {
      "react": "$react",
      "react-dom": "$react-dom"
    }
  },
  "devDependencies": {
    "@effect/tsgo": "0.63.0",
    "@gdp-ts/core": "0.1.0",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "effect": "4.1.0",
    "jsdom": "30.1.3",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "typescript": "7.0.2",
    "ultracite": "8.1.0",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wrangler": "4.156.0"
  }
}

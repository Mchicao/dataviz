{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dataviz-clinic-demo",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-30",
  "workers_dev": true,
  "assets": {
    "directory": "dist/studio",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "ratelimits": [
    { "name": "AI_PER_IP", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } },
    { "name": "AI_GLOBAL", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }
  ],
  "observability": { "enabled": false }
}
